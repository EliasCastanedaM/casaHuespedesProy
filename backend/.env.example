PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://usuario:password@host:5432/base
JWT_SECRET=cambia_esta_clave_por_una_muy_larga
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=https://www.casahuespedespimentel.com,https://casahuespedespimentel.com,https://casa-huespedes-proy.vercel.app

# Asesor IA. Nunca expongas AI_INTERNAL_TOKEN en el frontend público.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_MAX_OUTPUT_TOKENS=500
AI_INTERNAL_TOKEN=
HOTEL_NAME=Casa Huéspedes Pimentel
HOTEL_PHONE=
HOTEL_WEBSITE=https://www.casahuespedespimentel.com/

# Webhooks y Graph API de Meta.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0

# Embedded Signup para coexistencia. El flujo debe permanecer deshabilitado
# hasta confirmar aprobación de Meta y completar las verificaciones previas.
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_EMBEDDED_SIGNUP_ENABLED=false

# WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Página de Facebook / Messenger.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Instagram profesional. Con Facebook Login puede reutilizarse el Page token.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Link público entregado por Culqi.
CULQI_PAYMENT_URL=https://express.culqi.com/pago/A863017EB2

# Correo que recibirá los avisos del hospedaje.
HOTEL_NOTIFICATION_EMAIL=correo@gmail.com

# Correos automáticos mediante la API HTTPS de Brevo.
BREVO_API_KEY=tu_api_key_de_brevo
EMAIL_FROM_NAME=Casa Huéspedes Pimentel
EMAIL_FROM_EMAIL=correo_verificado_en_brevo@gmail.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Avisos al administrador. Mantener false hasta aprobar una plantilla UTILIDAD
# y validar el envío al teléfono de prueba. No añadir el teléfono de Pepe aquí.
BOOKING_ALERT_ENABLED=false
BOOKING_ALERT_TO=
BOOKING_ALERT_TEMPLATE_NAME=
BOOKING_ALERT_TEMPLATE_LANGUAGE=es

# Para pruebas solo con una conversación activa (24 h), usar session_text.
# En producción: template y dejar vacío BOOKING_ALERT_PILOT_SOURCE.
BOOKING_ALERT_MODE=template
BOOKING_ALERT_PILOT_SOURCE=

# Permite probar plantillas de los 3 canales sin enviar alertas reales.
# Al terminar pruebas y pasar a Pepe, dejar vacío.
BOOKING_ALERT_TEST_KEY_PREFIX=
